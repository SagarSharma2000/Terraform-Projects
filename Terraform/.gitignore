# ==========================================
# Terraform .gitignore (Standard Configuration)
# ==========================================

# 1. Environment & Secret files
*.env
*.tfvars
*.tfvars.json

# 2. Local State Files (Sensitive data & local state)
*.tfstate
*.tfstate.*
*.tfstate.backup
*.terraform.tfstate
*.terraform.tfstate.hcl

# 3. Terraform Directory & Internal Files
.terraform/
*.terraform

# 4. Overrides & Crash Logs
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log